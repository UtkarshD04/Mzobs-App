# Copy to .env.local. Leave EXPO_PUBLIC_API_URL unset — the app auto-detects
# the backend host from the Metro dev server connection (src/lib/config.js),
# which works for physical devices via Expo Go without manual IP updates.
# Only set this to override the default, e.g.:
#   iOS simulator     -> http://localhost:4000
#   Android emulator  -> http://10.0.2.2:4000
# EXPO_PUBLIC_API_URL=http://localhost:4000
